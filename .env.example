MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bds?appName=Cluster0
PORT=9000
FRONTEND_URL=http://localhost:3000,http://localhost:3001,https://bds.nvcn.id.vn
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Sepay sandbox (https://my.sepay.vn - Test mode)
SEPAY_MODE=test
SEPAY_MERCHANT_ID=your-merchant-id
SEPAY_SECRET_KEY=your-secret-key
SEPAY_ENV=sandbox
SEPAY_PAYMENT_PREFIX=BDS
SEPAY_API_KEY=your_test_api_key
# Tài khoản ngân hàng (VA) tạo trong SePay Test mode - dùng để sinh ảnh QR
SEPAY_BANK_ACCOUNT=595266
SEPAY_BANK_NAME=MBBank
# UserAPI đối soát giao dịch. Live=https://my.sepay.vn (key Live), Test=https://userapi-sandbox.sepay.vn (key Test)
SEPAY_USERAPI_URL=https://my.sepay.vn
# Bật mô phỏng khi chưa có credentials hoặc IPN không tới localhost
SEPAY_SIMULATE=true
# Public API — webhook SePay: https://<domain>/api/payment/webhook
API_URL=https://bdsapi.nvcn.id.vn/api

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://bdsapi.nvcn.id.vn/api/auth/google/callback
